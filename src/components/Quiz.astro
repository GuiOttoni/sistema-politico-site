---
export interface Pergunta { q: string; opcoes: string[]; certa: number; porque: string }
interface Props { perguntas: Pergunta[]; titulo?: string }
const { perguntas, titulo = 'Teste o que aprendeu' } = Astro.props;
---
<section class="mt-14 rounded-[2rem] border border-peach-300 bg-peach-50 p-6 sm:p-8" data-quiz>
  <h2 class="text-2xl font-bold">🎯 {titulo}</h2>
  <div class="mt-5 space-y-6">
    {perguntas.map((p, qi) => (
      <fieldset class="space-y-2" data-q data-certa={p.certa}>
        <legend class="font-bold">{qi + 1}. {p.q}</legend>
        <div class="grid gap-2 sm:grid-cols-2">
          {p.opcoes.map((o, oi) => (
            <button type="button" class="btn justify-start text-left" data-opt={oi}>{o}</button>
          ))}
        </div>
        <p class="hidden rounded-2xl bg-white p-3 text-sm text-ink-soft" data-why>{p.porque}</p>
      </fieldset>
    ))}
  </div>
  <p class="mt-6 font-bold text-peach-600" data-score aria-live="polite"></p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((quiz) => {
    const qs = quiz.querySelectorAll<HTMLElement>('[data-q]');
    const score = quiz.querySelector<HTMLElement>('[data-score]')!;
    let acertos = 0, respondidas = 0;
    qs.forEach((q) => {
      const certa = Number(q.dataset.certa);
      q.querySelectorAll<HTMLButtonElement>('[data-opt]').forEach((b) => {
        b.addEventListener('click', () => {
          if (q.dataset.done) return;
          q.dataset.done = '1';
          respondidas++;
          const ok = Number(b.dataset.opt) === certa;
          if (ok) acertos++;
          q.querySelectorAll<HTMLButtonElement>('[data-opt]').forEach((x) => {
            x.disabled = true;
            if (Number(x.dataset.opt) === certa) x.classList.add('!border-mint-300', '!bg-mint-100');
          });
          if (!ok) b.classList.add('!border-rose-300', '!bg-rose-100');
          q.querySelector('[data-why]')!.classList.remove('hidden');
          if (respondidas === qs.length) score.textContent = `Você acertou ${acertos} de ${qs.length}. ${acertos === qs.length ? 'Perfeito! 🎉' : 'Releia as explicações e tente de novo.'}`;
        });
      });
    });
  });
</script>
