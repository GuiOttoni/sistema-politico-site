---
import { trilha, niveis, href } from '../data/trilha';
import { tones } from '../lib/tones';
interface Props { slug: string }
const { slug } = Astro.props;
const i = trilha.findIndex((e) => e.slug === slug);
const e = trilha[i];
const t = tones[e.tone];
---
<section class={`rounded-[2rem] border ${t.border} ${t.bgSoft} p-6 sm:p-10`}>
  <div class="flex flex-wrap items-center gap-2">
    <span class={`chip ${t.chip}`}>Nível {e.nivel} · {niveis[e.nivel].nome}</span>
    <span class="chip bg-white text-ink-soft">⏱ {e.tempo}</span>
    <span class="chip bg-white text-ink-soft">Etapa {i + 1} de {trilha.length}</span>
  </div>
  <h1 class="mt-4 text-3xl font-bold sm:text-5xl"><span aria-hidden="true">{e.emoji}</span> {e.titulo}</h1>
  <p class="mt-3 max-w-2xl text-lg text-ink-soft">{e.resumo}</p>
  <ol class="mt-6 flex gap-1.5" aria-label="Progresso na trilha">
    {trilha.map((x, k) => (
      <li class="flex-1"><a href={href(x.slug)} title={x.titulo} class={`block h-2 rounded-full ${k === i ? 'bg-lilac-600' : k < i ? 'bg-lilac-300' : 'bg-white'}`}><span class="sr-only">{x.titulo}</span></a></li>
    ))}
  </ol>
</section>
