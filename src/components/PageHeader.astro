---
import Icon from './Icon.astro';
import { trilha, href } from '../data/trilha';
import { tones } from '../lib/tones';
interface Props { slug: string }
const { slug } = Astro.props;
const i = trilha.findIndex((e) => e.slug === slug);
const e = trilha[i];
const t = tones[e.tone];
---
<section class={`rounded-[2rem] border ${t.border} ${t.bgSoft} p-6 sm:p-10`}>
  <div class="flex flex-wrap items-center gap-2">
    <span class={`chip ${t.chip}`}>{e.grupo}</span>
    <span class="chip bg-white text-ink-soft"><Icon name="schedule" /> {e.tempo}</span>
    <span class="chip bg-white text-ink-soft">Etapa {i + 1} de {trilha.length}</span>
  </div>
  <h1 class="mt-4 flex items-center gap-3 text-3xl font-bold sm:text-5xl">
    <span class={`grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-white sm:h-14 sm:w-14 ${t.text}`}><Icon name={e.icon} /></span>
    {e.titulo}
  </h1>
  <p class="mt-3 max-w-2xl text-lg text-ink-soft">{e.resumo}</p>
  <div class="mt-5 flex flex-wrap gap-2" role="navigation" aria-label="Níveis desta página">
    <a href="#basico" class="btn !border-mint-300 !bg-mint-50 !text-mint-600"><Icon name="school" /> Básico</a>
    <a href="#avancado" class="btn !border-lilac-300 !bg-lilac-50 !text-lilac-600"><Icon name="psychology" /> Avançado</a>
    <a href="#quiz" class="btn"><Icon name="quiz" /> Exercícios</a>
  </div>
  <ol class="mt-6 flex gap-1.5" aria-label="Progresso na trilha">
    {trilha.map((x, k) => (
      <li class="flex-1"><a href={href(x.slug)} title={x.titulo} class={`block h-2 rounded-full ${k === i ? 'bg-lilac-600' : k < i ? 'bg-lilac-300' : 'bg-white'}`}><span class="sr-only">{x.titulo}</span></a></li>
    ))}
  </ol>
</section>
