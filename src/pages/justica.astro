---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PageNav from '../components/PageNav.astro';
import LevelBlock from '../components/LevelBlock.astro';
import Section from '../components/Section.astro';
import Callout from '../components/Callout.astro';
import InfoCard from '../components/InfoCard.astro';
import Icon from '../components/Icon.astro';
import Fonte from '../components/Fonte.astro';
import Quiz from '../components/Quiz.astro';
import { tones, type Tone } from '../lib/tones';
import { art, L } from '../data/links';

interface Ramo { id: string; nome: string; icon: string; tone: Tone; faz: string; cupula: string; segundo: string; primeiro: string }
const ramos: Ramo[] = [
  { id: 'stf', nome: 'Supremo Tribunal Federal', icon: 'account_balance', tone: 'lilac', faz: 'É o guardião da Constituição. Decide se leis e atos respeitam a Constituição e julga as principais autoridades do país.',
    cupula: 'STF: 11 ministros', segundo: 'Não há', primeiro: 'Não há' },
  { id: 'fed', nome: 'Justiça Federal', icon: 'flag', tone: 'sky', faz: 'Julga causas em que a União, autarquias ou empresas públicas federais têm interesse.',
    cupula: 'STJ: no mínimo 33 ministros (uniformiza a interpretação da lei federal)', segundo: '6 Tribunais Regionais Federais (TRF 1 a 6)', primeiro: 'Juízes federais e Juizados Especiais Federais' },
  { id: 'est', nome: 'Justiça Estadual', icon: 'map', tone: 'mint', faz: 'Julga a maior parte das causas: tudo o que não for da Justiça Federal ou das Justiças especializadas (cível, família, criminal comum e outras).',
    cupula: 'STJ (recursos sobre a lei federal)', segundo: '27 Tribunais de Justiça (desembargadores)', primeiro: 'Juízes de Direito, Tribunal do Júri e Juizados Especiais' },
  { id: 'trab', nome: 'Justiça do Trabalho', icon: 'engineering', tone: 'peach', faz: 'Resolve conflitos entre trabalhadores e empregadores.',
    cupula: 'TST: 27 ministros', segundo: '24 Tribunais Regionais do Trabalho', primeiro: 'Varas do Trabalho' },
  { id: 'eleit', nome: 'Justiça Eleitoral', icon: 'how_to_vote', tone: 'butter', faz: 'Organiza e fiscaliza as eleições, registra partidos e candidatos, julga conflitos eleitorais e diploma os eleitos.',
    cupula: 'TSE: no mínimo 7 ministros', segundo: '27 Tribunais Regionais Eleitorais', primeiro: 'Juízes eleitorais e Juntas Eleitorais' },
  { id: 'mil', nome: 'Justiça Militar', icon: 'military_tech', tone: 'rose', faz: 'Julga crimes militares. Na União, os das Forças Armadas. Nos Estados, os de policiais e bombeiros militares.',
    cupula: 'STM: 15 ministros (Justiça Militar da União)', segundo: 'Tribunais de Justiça Militar (SP, MG e RS) ou os próprios Tribunais de Justiça', primeiro: 'Conselhos de Justiça e juízes auditores' },
];

const funcoes = [
  { icon: 'shield', tone: 'sky' as const, nome: 'Ministério Público', arts: 'Arts. 127 a 130-A', txt: 'Defende a ordem jurídica, o regime democrático e os interesses da sociedade. Apresenta, de forma privativa, a ação penal pública e atua em ações para proteger o patrimônio público, o meio ambiente e os consumidores.' },
  { icon: 'account_balance', tone: 'lilac' as const, nome: 'Advocacia Pública', arts: 'Arts. 131 e 132', txt: 'Representa a União, os Estados e o DF na Justiça e dá consultoria jurídica ao Executivo. Na União, é a Advocacia-Geral da União (AGU).' },
  { icon: 'balance', tone: 'mint' as const, nome: 'Advocacia', arts: 'Art. 133', txt: 'O advogado é indispensável à administração da justiça e inviolável por seus atos e manifestações no exercício da profissão, nos limites da lei.' },
  { icon: 'volunteer_activism', tone: 'peach' as const, nome: 'Defensoria Pública', arts: 'Arts. 134 e 135', txt: 'Oferece orientação e defesa gratuitas, dentro e fora dos tribunais, a quem não pode pagar um advogado.' },
];
---
<Base title="Justiça e fiscalização" slug="justica">
  <PageHeader slug="justica" />

  <LevelBlock nivel="basico">
    <Section title="O que faz o Poder Judiciário">
      <Fragment slot="intro">
        <p>O Judiciário aplica as leis para resolver conflitos e proteger direitos. Diferentemente de presidentes e parlamentares, os juízes não são eleitos: em geral, entram na carreira por <strong>concurso público</strong>. Assim, podem decidir com base na lei, mesmo contra a vontade da maioria do momento.</p>
        <p>Duas regras são centrais: nenhuma lei pode impedir alguém de recorrer à Justiça (art. 5º, XXXV) e não pode haver tribunal criado só para julgar um caso depois que ele aconteceu (art. 5º, XXXVII).</p>
      </Fragment>
    </Section>

    <Section title="Os ramos da Justiça">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {ramos.map((r) => <InfoCard tone={r.tone} icon={r.icon} title={r.nome}><p>{r.faz}</p></InfoCard>)}
      </div>
    </Section>

    <Section title="Quem acusa, quem defende e quem representa o Estado">
      <Fragment slot="intro">
        <p>Para o juiz ser imparcial, as funções de <strong>julgar</strong>, <strong>acusar</strong> e <strong>defender</strong> ficam em instituições diferentes. Estas são as “Funções Essenciais à Justiça”. Elas são independentes e não fazem parte dos três Poderes.</p>
      </Fragment>
      <div class="grid gap-4 sm:grid-cols-2">
        {funcoes.map((f) => <InfoCard tone={f.tone} icon={f.icon} tag={f.arts} title={f.nome}><p>{f.txt}</p></InfoCard>)}
      </div>
    </Section>

    <Fonte itens={[art(5, '(incisos XXXV e XXXVII)'), art(92), art(127), art(131), art(133), art(134), L.cnjPanorama, L.cnjPapel]} />
  </LevelBlock>

  <LevelBlock nivel="avancado">
    <Section title="Organização dos tribunais">
      <Fragment slot="intro"><p>Escolha um ramo para ver os níveis: tribunal superior (cúpula), tribunais de segunda instância e primeira instância.</p></Fragment>
      <div class="flex flex-wrap gap-2" id="ramos" role="group" aria-label="Ramos da Justiça">
        {ramos.map((r, i) => <button type="button" class={`btn ${i === 0 ? 'is-active' : ''}`} aria-pressed={i === 0} data-id={r.id}><Icon name={r.icon} /> {r.nome}</button>)}
      </div>
      {ramos.map((r, i) => {
        const t = tones[r.tone];
        return (
          <div data-ramo={r.id} class={`mt-4 rounded-3xl border ${t.border} ${t.bgSoft} p-6 ${i === 0 ? '' : 'hidden'}`}>
            <h3 class="flex items-center gap-2 text-xl font-bold"><Icon name={r.icon} class={t.text} /> {r.nome}</h3>
            <ol class="mt-4 grid gap-3 sm:grid-cols-3">
              <li class="card"><p class="text-xs font-extrabold uppercase text-ink-soft">Cúpula</p><p class="mt-1 font-bold">{r.cupula}</p></li>
              <li class="card"><p class="text-xs font-extrabold uppercase text-ink-soft">2º grau</p><p class="mt-1 font-bold">{r.segundo}</p></li>
              <li class="card"><p class="text-xs font-extrabold uppercase text-ink-soft">1º grau</p><p class="mt-1 font-bold">{r.primeiro}</p></li>
            </ol>
          </div>
        );
      })}
      <div class="mt-5 grid gap-4 lg:grid-cols-2">
        <Callout tone="butter" icon="admin_panel_settings" title="CNJ: controle administrativo">
          <p>O Conselho Nacional de Justiça (15 conselheiros) <strong>não julga processos</strong>. Ele controla o funcionamento administrativo e financeiro do Judiciário e mantém a Escola Nacional do Judiciário (ENAJU).</p>
        </Callout>
        <Callout tone="lilac" icon="percent" title="Quinto constitucional">
          <p>Um quinto das vagas do TST, dos TRTs, dos TRFs e dos Tribunais de Justiça é ocupado por advogados e membros do Ministério Público com mais de 10 anos de atividade.</p>
        </Callout>
      </div>
    </Section>

    <Section title="Tribunal de Contas da União (TCU)">
      <Fragment slot="intro">
        <p>O Congresso fiscaliza o uso do dinheiro público (arts. 70 a 75) com ajuda técnica do TCU. O TCU <strong>não faz parte do Judiciário</strong>: ele julga <em>contas</em>, não pessoas, e suas decisões podem ser revistas pela Justiça. Tem 9 ministros, dos quais 3 são escolhidos pelo Presidente (com aprovação do Senado) e 6 pelo Congresso (art. 73).</p>
      </Fragment>

      <div class="flex gap-2" id="contas" role="group" aria-label="Tipos de contas">
        <button type="button" class="btn is-active" aria-pressed="true" data-c="gov"><Icon name="bar_chart" /> Contas de governo</button>
        <button type="button" class="btn" aria-pressed="false" data-c="gestao"><Icon name="receipt_long" /> Contas de gestão</button>
      </div>
      <div data-conta="gov" class="mt-4 rounded-3xl border border-sky-300 bg-sky-50 p-6">
        <h3 class="text-xl font-bold">Contas do Presidente (art. 71, I): o TCU apenas opina</h3>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-ink-soft">
          <li>O TCU emite um <strong>parecer prévio</strong> em até 60 dias após receber as contas anuais do Presidente.</li>
          <li>O parecer <strong>não obriga</strong> o Congresso, que faz o julgamento final.</li>
          <li>Nos Municípios, o parecer do Tribunal de Contas só deixa de valer por voto de <strong>2/3 da Câmara Municipal</strong> (art. 31, § 2º).</li>
        </ul>
      </div>
      <div data-conta="gestao" class="mt-4 hidden rounded-3xl border border-rose-300 bg-rose-50 p-6">
        <h3 class="text-xl font-bold">Contas dos administradores (art. 71, II): o TCU julga</h3>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-ink-soft">
          <li>Julga as contas de quem administra dinheiro, bens e valores públicos, em todos os Poderes e nas empresas estatais.</li>
          <li>Pode aplicar multas e fixar prazo para corrigir ilegalidades (art. 71, VIII e IX).</li>
          <li>Não pode sustar contratos por conta própria: essa decisão cabe ao Congresso (art. 71, §§ 1º e 2º).</li>
        </ul>
      </div>
      <div class="mt-5">
        <Callout tone="mint" icon="calculate" title="Reforma Tributária (EC 132/2023)">
          <p>O TCU também passou a calcular os coeficientes do Fundo Nacional de Desenvolvimento Regional e os cálculos que o Senado usa para fixar as alíquotas do IBS e da CBS.</p>
        </Callout>
      </div>
    </Section>

    <Fonte itens={[art(71), art(73), art(92), art(102, '(STF)'), art(104, '(STJ)'), art('111', '(Justiça do Trabalho)'), art(118, '(Justiça Eleitoral)'), art(122, '(Justiça Militar)'), L.stfArt71, L.lei8443, L.tcu, L.cnjPanorama]} />
  </LevelBlock>

  <Quiz id="quiz" perguntas={[
    { q: 'O TCU faz parte do Poder Judiciário?', opcoes: ['Sim', 'Não: auxilia o Congresso no controle externo', 'Só em nível estadual', 'Depende do caso'], certa: 1, porque: 'O TCU não exerce função jurisdicional (art. 71). Suas decisões podem ser revistas pela Justiça.' },
    { q: 'Quem apresenta a ação penal pública?', opcoes: ['Defensoria Pública', 'Advocacia-Geral da União', 'Ministério Público', 'CNJ'], certa: 2, porque: 'Art. 129, I: é função privativa do Ministério Público.' },
    { q: 'O CNJ julga processos de cidadãos?', opcoes: ['Sim, como última instância', 'Não: faz o controle administrativo do Judiciário', 'Só processos trabalhistas', 'Só causas contra o governo'], certa: 1, porque: 'É um órgão de controle administrativo e financeiro, sem função de julgar processos.' },
    { q: 'Qual Justiça organiza as eleições?', opcoes: ['Federal', 'Eleitoral', 'Militar', 'Estadual'], certa: 1, porque: 'A Justiça Eleitoral é formada pelo TSE, pelos 27 TREs e pelos juízes e juntas eleitorais.' },
  ]} />

  <PageNav slug="justica" />

  <script>
    const wire = (sel: string, attr: string, panel: string) => {
      const btns = document.querySelectorAll<HTMLButtonElement>(`${sel} button`);
      const panels = document.querySelectorAll<HTMLElement>(`[${panel}]`);
      btns.forEach((b) => b.addEventListener('click', () => {
        const id = b.dataset[attr]!;
        btns.forEach((x) => { const on = x === b; x.classList.toggle('is-active', on); x.setAttribute('aria-pressed', String(on)); });
        panels.forEach((p) => p.classList.toggle('hidden', p.getAttribute(panel) !== id));
      }));
    };
    wire('#ramos', 'id', 'data-ramo');
    wire('#contas', 'c', 'data-conta');
  </script>
</Base>
