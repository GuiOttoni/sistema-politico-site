---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/ui/Icon.astro';
import { trilha, grupos, href } from '@/data/trilha';
import { tones } from '@/lib/tones';
---
<Base title="Sistema Político do Brasil: guia interativo, do básico ao avançado">
  <section class="relative overflow-hidden rounded-[2.5rem] border border-lilac-300 bg-lilac-50 p-8 sm:p-14">
    <div class="pointer-events-none absolute -right-10 -top-10 h-56 w-56 rounded-full bg-peach-100 opacity-70 blur-2xl"></div>
    <div class="pointer-events-none absolute -bottom-16 left-1/3 h-56 w-56 rounded-full bg-mint-100 opacity-70 blur-2xl"></div>
    <div class="relative max-w-3xl">
      <span class="chip bg-white text-lilac-600"><Icon name="menu_book" /> Constituição de 1988 · conteúdo conferido em fontes oficiais</span>
      <h1 class="mt-5 text-4xl font-bold leading-tight sm:text-6xl">Como funciona o sistema político do <span class="text-lilac-600">Brasil</span></h1>
      <p class="mt-5 text-lg text-ink-soft">Um guia em 9 etapas, com cards, simuladores e exercícios. Cada etapa tem uma parte <strong>básica</strong>, com o essencial, e uma parte <strong>avançada</strong>, com os detalhes técnicos.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={href('constituicao')} class="btn !border-lilac-600 !bg-lilac-600 !text-white">Começar pelo básico <Icon name="arrow_forward" /></a>
        <a href={href('federacao')} class="btn"><Icon name="account_balance" /> Simulador “Quem faz o quê?”</a>
      </div>
    </div>
  </section>

  <section class="mt-12 grid gap-4 sm:grid-cols-3" aria-label="Como usar o guia">
    {[
      ['school', 'mint', 'Básico', 'Conceitos essenciais em linguagem simples. Leia primeiro.'],
      ['psychology', 'lilac', 'Avançado', 'Regras detalhadas, números e decisões judiciais. Para aprofundar.'],
      ['verified', 'sky', 'Fontes oficiais', 'Cada etapa traz links para a Constituição, leis e órgãos públicos.'],
    ].map(([i, tone, t, d]) => (
      <div class="card"><div class={`grid h-12 w-12 place-items-center rounded-2xl text-2xl ${tones[tone as 'mint'].bg} ${tones[tone as 'mint'].text}`}><Icon name={i} /></div><h2 class="mt-3 text-lg font-bold">{t}</h2><p class="mt-1 text-sm text-ink-soft">{d}</p></div>
    ))}
  </section>

  {grupos.map((g) => (
    <section class="mt-14">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <h2 class="text-3xl font-bold">{g.nome}</h2>
        <p class="text-ink-soft">{g.descricao}</p>
      </div>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {trilha.filter((e) => e.grupo === g.nome).map((e) => {
          const t = tones[e.tone];
          return (
            <a href={href(e.slug)} class="group card relative flex flex-col transition hover:-translate-y-1 hover:shadow-lg">
              <span class="absolute right-4 top-4 hidden items-center gap-1 text-xs font-bold text-mint-600" data-done={e.slug}><Icon name="check_circle" fill /> visto</span>
              <div class={`grid h-14 w-14 place-items-center rounded-2xl text-3xl ${t.bg} ${t.text}`}><Icon name={e.icon} /></div>
              <h3 class="mt-4 text-xl font-bold">{e.titulo}</h3>
              <p class="mt-2 flex-1 text-sm text-ink-soft">{e.resumo}</p>
              <div class="mt-4 flex flex-wrap items-center gap-2">
                <span class="chip bg-mint-100 text-mint-600">Básico</span>
                <span class="chip bg-lilac-100 text-lilac-600">Avançado</span>
                <span class="ml-auto flex items-center gap-1 text-sm font-bold text-ink-soft"><Icon name="schedule" /> {e.tempo}</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  ))}

  <section class="mt-14 grid gap-4 sm:grid-cols-3">
    <a href={href('glossario')} class="card bg-butter-50 transition hover:-translate-y-1"><h2 class="flex items-center gap-2 text-xl font-bold"><Icon name="dictionary" class="text-butter-600" /> Glossário</h2><p class="mt-1 text-sm text-ink-soft">Termos explicados de forma simples, com busca.</p></a>
    <a href={href('validacao')} class="card bg-mint-50 transition hover:-translate-y-1"><h2 class="flex items-center gap-2 text-xl font-bold"><Icon name="fact_check" class="text-mint-600" /> Conferência</h2><p class="mt-1 text-sm text-ink-soft">O que foi verificado em fonte oficial, o que foi corrigido e o que ainda não foi confirmado.</p></a>
    <a href={href('fontes')} class="card bg-sky-50 transition hover:-translate-y-1"><h2 class="flex items-center gap-2 text-xl font-bold"><Icon name="link" class="text-sky-600" /> Fontes</h2><p class="mt-1 text-sm text-ink-soft">As 80 referências da pesquisa original.</p></a>
  </section>
</Base>
