---
import Base from '@/layouts/Base.astro';
import fontes from '@/data/referencias.json';
import Icon from '@/components/ui/Icon.astro';
import { L, REPO_LEIS } from '@/data/links';
---
<Base title="Fontes e referências" description="As 80 referências usadas na pesquisa que originou este site.">
  <section class="rounded-[2rem] border border-sky-300 bg-sky-50 p-6 sm:p-10">
    <h1 class="flex items-center gap-3 text-3xl font-bold sm:text-5xl"><Icon name="link" class="text-sky-600" /> Fontes e referências</h1>
    <p class="mt-3 max-w-2xl text-lg text-ink-soft">Lista das {fontes.length} referências da pesquisa “Arquitetura Institucional e Dinâmica Política do Brasil”, na ordem original. Há fontes oficiais (Planalto, Senado, Câmara, CNJ, TSE, STF) e fontes de apoio (artigos, notícias e materiais de estudo). As fontes oficiais usadas em cada etapa estão no fim de cada seção. O resultado da checagem está na página <a class="font-bold underline" href="../validacao/">Conferência</a>.</p>
    <label class="mt-5 block max-w-md text-sm font-bold">Buscar
      <input id="q" type="search" placeholder="ex.: TSE, cláusula, Abranches…" class="mt-1 w-full rounded-full border border-line bg-white px-5 py-3 text-base" />
    </label>
  </section>

  <section class="mt-8 rounded-3xl border border-sky-300 bg-white p-6">
    <h2 class="flex items-center gap-2 text-2xl font-bold"><Icon name="markdown" class="text-sky-600" /> Repositório de apoio: ctresb/leis</h2>
    <p class="prose-p mt-3 max-w-3xl">O repositório <a class="font-bold underline" href={REPO_LEIS} target="_blank" rel="noopener noreferrer">ctresb/leis</a> reúne a legislação brasileira em Markdown: a Constituição Federal, leis federais, estaduais e municipais, tratados e decisões do STF. Cada arquivo traz um cabeçalho com o link da fonte oficial.</p>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-ink-soft">
      <li>Neste site, os links “Markdown” aparecem ao lado das fontes oficiais (por exemplo, a Constituição e as leis eleitorais).</li>
      <li>O próprio repositório avisa que os textos são <strong>conversões automáticas</strong> (com OCR em documentos escaneados) e <strong>não substituem o Diário Oficial</strong>. Por isso, ele é tratado aqui como fonte de apoio, e a fonte oficial vem sempre primeiro.</li>
      <li>O código do repositório usa a licença MIT. Os textos das normas são atos oficiais, que não têm proteção autoral (Lei nº 9.610/1998, art. 8º, I).</li>
    </ul>
    <div class="mt-4 flex flex-wrap gap-2 text-sm">
      <a class="btn" href={REPO_LEIS} target="_blank" rel="noopener noreferrer"><Icon name="open_in_new" /> Abrir o repositório</a>
      <a class="btn" href={L.cf.md} target="_blank" rel="noopener noreferrer"><Icon name="menu_book" /> Constituição em Markdown</a>
    </div>
  </section>

  <p class="mt-6 text-sm text-ink-soft" id="n" aria-live="polite"></p>
  <ol class="mt-3 grid gap-3 sm:grid-cols-2" id="lista">
    {fontes.map((f) => (
      <li class="card !p-4" data-t={`${f.titulo} ${f.url}`.toLowerCase()} value={f.n}>
        <span class="chip bg-lilac-100 text-lilac-600">{f.n}</span>
        <a href={f.url} target="_blank" rel="noopener noreferrer" class="mt-2 block font-bold underline decoration-lilac-300 underline-offset-4 hover:text-lilac-600">{f.titulo}</a>
        <p class="mt-1 break-all text-xs text-ink-soft">{f.url}</p>
      </li>
    ))}
  </ol>

  <script>
    const q = document.getElementById('q') as HTMLInputElement;
    const items = document.querySelectorAll<HTMLElement>('#lista li');
    const n = document.getElementById('n')!;
    const run = () => {
      const v = q.value.trim().toLowerCase();
      let c = 0;
      items.forEach((li) => { const ok = !v || li.dataset.t!.includes(v); li.classList.toggle('hidden', !ok); if (ok) c++; });
      n.textContent = `${c} de ${items.length} fontes`;
    };
    q.addEventListener('input', run);
    run();
  </script>
</Base>
