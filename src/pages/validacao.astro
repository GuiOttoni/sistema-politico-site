---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { itens, dataConferencia, type Status } from '../data/validacao';

const meta: Record<Status, { nome: string; icon: string; chip: string; borda: string }> = {
  confirmado: { nome: 'Confirmado', icon: 'check_circle', chip: 'bg-mint-100 text-mint-600', borda: 'border-mint-300' },
  corrigido: { nome: 'Corrigido', icon: 'edit_note', chip: 'bg-butter-100 text-butter-600', borda: 'border-butter-300' },
  pendente: { nome: 'Não confirmado', icon: 'help', chip: 'bg-rose-100 text-rose-600', borda: 'border-rose-300' },
};
const contagem = (s: Status) => itens.filter((i) => i.status === s).length;
---
<Base title="Conferência das informações" description="O que foi conferido em fontes oficiais, o que foi corrigido e o que ainda não foi confirmado.">
  <section class="rounded-[2rem] border border-mint-300 bg-mint-50 p-6 sm:p-10">
    <h1 class="flex items-center gap-3 text-3xl font-bold sm:text-5xl"><Icon name="fact_check" class="text-mint-600" /> Conferência das informações</h1>
    <p class="mt-3 max-w-3xl text-lg text-ink-soft">Este site se baseia em uma pesquisa em PDF. Em {dataConferencia}, os principais pontos foram comparados com o texto oficial da Constituição (Planalto), com as emendas e leis publicadas e com notícias do STF e do TSE. Aqui está o resultado, sem esconder o que não foi possível confirmar.</p>
    <div class="mt-5 flex flex-wrap gap-2" id="filtro" role="group" aria-label="Filtrar por situação">
      <button type="button" class="btn is-active" aria-pressed="true" data-s="todos">Todos ({itens.length})</button>
      {(Object.keys(meta) as Status[]).map((s) => <button type="button" class="btn" aria-pressed="false" data-s={s}><Icon name={meta[s].icon} /> {meta[s].nome} ({contagem(s)})</button>)}
    </div>
  </section>

  <ul class="mt-8 space-y-4" id="lista">
    {itens.map((i) => {
      const m = meta[i.status];
      return (
        <li class={`card ${m.borda}`} data-s={i.status}>
          <div class="flex flex-wrap items-center gap-2">
            <span class={`chip ${m.chip}`}><Icon name={m.icon} /> {m.nome}</span>
            <span class="chip bg-white text-ink-soft ring-1 ring-line">Etapa: {i.pagina}</span>
          </div>
          <p class="mt-2 font-bold">{i.afirmacao}</p>
          {i.nota && <p class="mt-1 text-sm text-ink-soft">{i.nota}</p>}
          <ul class="mt-3 flex flex-wrap gap-2 text-sm">
            {i.fonte.map((f) => (
              <li><a href={f.url} target="_blank" rel="noopener noreferrer" class="chip bg-lilac-50 text-lilac-600 hover:bg-lilac-100"><Icon name={f.oficial ? 'account_balance' : 'article'} /> {f.rotulo} <Icon name="open_in_new" /></a></li>
            ))}
          </ul>
        </li>
      );
    })}
  </ul>

  <script>
    const btns = document.querySelectorAll<HTMLButtonElement>('#filtro button');
    const lis = document.querySelectorAll<HTMLElement>('#lista > li');
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => { const on = x === b; x.classList.toggle('is-active', on); x.setAttribute('aria-pressed', String(on)); });
      lis.forEach((li) => li.classList.toggle('hidden', b.dataset.s !== 'todos' && li.dataset.s !== b.dataset.s));
    }));
  </script>
</Base>
