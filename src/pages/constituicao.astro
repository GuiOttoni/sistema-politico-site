---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PageNav from '../components/PageNav.astro';
import LevelBlock from '../components/LevelBlock.astro';
import Section from '../components/Section.astro';
import Callout from '../components/Callout.astro';
import Icon from '../components/Icon.astro';
import Fonte from '../components/Fonte.astro';
import Quiz from '../components/Quiz.astro';
import { tones, type Tone } from '../lib/tones';
import { art, L } from '../data/links';

const pilares: { tone: Tone; icon: string; nome: string; pergunta: string; explica: string; contraste: string; base: string }[] = [
  { tone: 'rose', icon: 'how_to_vote', nome: 'República', pergunta: 'Forma de governo: como o governante chega ao cargo?',
    explica: 'Os governantes são escolhidos por eleição, ficam no cargo por um tempo determinado e precisam prestar contas dos seus atos.',
    contraste: 'Na monarquia, o cargo é vitalício e passa por herança.', base: 'Art. 1º' },
  { tone: 'sky', icon: 'hub', nome: 'Federação', pergunta: 'Forma de Estado: como o poder é dividido no território?',
    explica: 'O poder é dividido entre a União, os 26 Estados, o Distrito Federal e os Municípios. Cada um tem governo próprio e autonomia, e nenhum pode deixar a Federação.',
    contraste: 'No Estado unitário, as decisões ficam concentradas em um único centro.', base: 'Arts. 1º e 18' },
  { tone: 'mint', icon: 'person', nome: 'Presidencialismo', pergunta: 'Sistema de governo: quem chefia o governo?',
    explica: 'O Presidente da República é, ao mesmo tempo, chefe de Estado e chefe de governo. É eleito diretamente pelo povo e tem mandato fixo.',
    contraste: 'No parlamentarismo, o governo é chefiado por um primeiro-ministro escolhido pelo Parlamento.', base: 'Arts. 2º e 76 a 84' },
  { tone: 'lilac', icon: 'groups', nome: 'Democracia semidireta', pergunta: 'Regime político: como o povo participa?',
    explica: 'Todo poder vem do povo. Ele o exerce por meio de representantes eleitos e também diretamente, por plebiscito, referendo e iniciativa popular de leis.',
    contraste: 'Combina a democracia representativa com instrumentos de participação direta.', base: 'Art. 1º, parágrafo único' },
];

const fundamentos = [
  ['flag', 'Soberania'], ['badge', 'Cidadania'], ['favorite', 'Dignidade da pessoa humana'],
  ['work', 'Valores sociais do trabalho e da livre iniciativa'], ['diversity_3', 'Pluralismo político'],
];

const pecs = [
  { q: 'Uma proposta de emenda (PEC) quer acabar com o voto secreto. Ela pode ser discutida no Congresso?', opcoes: ['Pode ser discutida', 'Não pode: é cláusula pétrea'], certa: 1,
    porque: 'O voto direto, secreto, universal e periódico é cláusula pétrea (art. 60, § 4º, II).' },
  { q: 'Uma PEC propõe mudar as regras de aposentadoria. Pode ser discutida?', opcoes: ['Pode ser discutida', 'Não pode: é cláusula pétrea'], certa: 0,
    porque: 'Aposentadoria não está entre as cláusulas pétreas. A Constituição já foi alterada várias vezes sobre esse tema.' },
  { q: 'Uma PEC propõe que um Estado deixe de ter governo próprio e seja administrado diretamente pela União. E agora?', opcoes: ['Pode ser discutida', 'Não pode: é cláusula pétrea'], certa: 1,
    porque: 'A proposta tende a abolir a forma federativa de Estado (art. 60, § 4º, I).' },
  { q: 'Uma PEC propõe que o Judiciário passe a obedecer ordens do Executivo. Pode?', opcoes: ['Pode ser discutida', 'Não pode: é cláusula pétrea'], certa: 1,
    porque: 'A separação dos Poderes é cláusula pétrea (art. 60, § 4º, III).' },
  { q: 'Uma PEC propõe incluir um novo direito social no texto, como foi feito com o transporte (EC 90/2015). Pode?', opcoes: ['Pode ser discutida', 'Não pode: é cláusula pétrea'], certa: 0,
    porque: 'Ampliar direitos é permitido. A cláusula pétrea barra apenas propostas que tendam a abolir direitos e garantias individuais.' },
];
---
<Base title="A Constituição e os 4 pilares" slug="constituicao">
  <PageHeader slug="constituicao" />

  <LevelBlock nivel="basico">
    <Section title="O que é a Constituição?">
      <Fragment slot="intro">
        <p>A Constituição é a lei mais importante do país. Ela define como o Estado é organizado, quais são os poderes e quais são os direitos de cada pessoa. Todas as outras leis precisam respeitá-la.</p>
        <p>A atual foi promulgada em <strong>5 de outubro de 1988</strong>, depois do fim do regime militar (1964–1985). Por isso é chamada de “Constituição Cidadã”: ela dá grande importância aos direitos das pessoas.</p>
      </Fragment>
    </Section>

    <Section title="Os 5 fundamentos da República">
      <Fragment slot="intro"><p>O artigo 1º diz que o Brasil é um Estado Democrático de Direito, apoiado em cinco fundamentos:</p></Fragment>
      <ul class="flex flex-wrap gap-3">
        {fundamentos.map(([i, n]) => (
          <li class="card flex items-center gap-3 !py-3"><Icon name={i} class="text-2xl text-lilac-600" /><span class="font-bold">{n}</span></li>
        ))}
      </ul>
    </Section>

    <Section title="Os 4 pilares do sistema">
      <Fragment slot="intro">
        <p>Quatro termos diferentes respondem a quatro perguntas diferentes. É comum confundi-los. Clique em cada cartão para abrir a explicação.</p>
      </Fragment>
      <div class="grid gap-4 sm:grid-cols-2">
        {pilares.map((p) => {
          const t = tones[p.tone];
          return (
            <details class={`group rounded-3xl border ${t.border} ${t.bgSoft} p-5 open:shadow-md`}>
              <summary class="flex cursor-pointer list-none items-center gap-4">
                <span class={`grid h-14 w-14 shrink-0 place-items-center rounded-2xl text-3xl ${t.bg} ${t.text}`}><Icon name={p.icon} /></span>
                <span class="flex-1">
                  <span class="block font-display text-2xl font-bold">{p.nome}</span>
                  <span class={`block text-xs font-bold ${t.text}`}>{p.pergunta}</span>
                </span>
                <Icon name="expand_more" class="text-2xl transition group-open:rotate-180" />
              </summary>
              <div class="prose-p mt-4">
                <p>{p.explica}</p>
                <p><strong>Para comparar:</strong> {p.contraste}</p>
                <span class={`chip ${t.chip}`}><Icon name="menu_book" /> {p.base}</span>
              </div>
            </details>
          );
        })}
      </div>
    </Section>

    <Fonte itens={[art(1), art(2), art(18), L.cf, L.senadoGuia]} />
  </LevelBlock>

  <LevelBlock nivel="avancado">
    <Section title="Estrutura e mudanças do texto">
      <Fragment slot="intro">
        <p>A Constituição é <strong>analítica</strong>: trata em detalhe de educação, saúde, trabalho, moradia e muitos outros temas. Isso protege conquistas sociais, mas exige alterações frequentes no texto.</p>
        <p>Segundo o quadro oficial do Planalto, já foram promulgadas <strong>141 emendas constitucionais</strong> (a mais recente é a EC 141, de 16/10/2026), além de 6 emendas de revisão de 1994. Tratados de direitos humanos aprovados com rito especial também têm valor de emenda (art. 5º, § 3º).</p>
      </Fragment>
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="card bg-lilac-50"><p class="font-display text-4xl font-bold text-lilac-600">9</p><p class="text-sm text-ink-soft">títulos, dos Princípios Fundamentais (arts. 1º a 4º) às Disposições Gerais (arts. 234 a 250).</p></div>
        <div class="card bg-mint-50"><p class="font-display text-4xl font-bold text-mint-600">3/5</p><p class="text-sm text-ink-soft">dos votos (308 deputados e 49 senadores), em dois turnos em cada Casa, para aprovar uma PEC.</p></div>
        <div class="card bg-peach-50"><p class="font-display text-4xl font-bold text-peach-600">Art. 19</p><p class="text-sm text-ink-soft">O Estado é laico: nenhum ente pode estabelecer ou subvencionar cultos religiosos.</p></div>
      </div>
    </Section>

    <Section title="Cláusulas pétreas">
      <Fragment slot="intro">
        <p>O art. 60, § 4º lista o núcleo que nenhuma emenda pode abolir. Uma proposta “tendente a abolir” qualquer um destes itens nem chega a ser discutida:</p>
      </Fragment>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <li class="card flex items-center gap-2 bg-rose-50"><Icon name="hub" class="text-rose-600" /> A forma federativa de Estado</li>
        <li class="card flex items-center gap-2 bg-sky-50"><Icon name="how_to_vote" class="text-sky-600" /> O voto direto, secreto, universal e periódico</li>
        <li class="card flex items-center gap-2 bg-mint-50"><Icon name="balance" class="text-mint-600" /> A separação dos Poderes</li>
        <li class="card flex items-center gap-2 bg-lilac-50"><Icon name="shield" class="text-lilac-600" /> Os direitos e garantias individuais</li>
      </ul>
      <div class="mt-4">
        <Callout tone="butter" icon="lightbulb" title="Observação">
          <p>A PEC não passa por sanção ou veto do Presidente: é promulgada pelas Mesas da Câmara e do Senado.</p>
        </Callout>
      </div>
    </Section>

    <Section title="Participação direta do povo">
      <Fragment slot="intro">
        <p>O parágrafo único do art. 1º e o art. 14 preveem três instrumentos de democracia direta, regulados pela Lei nº 9.709/1998: <strong>plebiscito</strong> (consulta antes da lei), <strong>referendo</strong> (consulta depois da lei) e <strong>iniciativa popular</strong> (projeto de lei proposto por cidadãos; veja a etapa “Como uma lei é criada”).</p>
      </Fragment>
    </Section>

    <Fonte itens={[art('60', '(§ 4º: cláusulas pétreas)'), art(14), art(19), art(5, '(§ 3º: tratados)'), L.emendas, L.lei9709]} />
  </LevelBlock>

  <Quiz titulo="Exercício: essa PEC pode ser discutida?" perguntas={pecs} />
  <Quiz id="quiz" titulo="Revisão" perguntas={[
    { q: 'Qual pilar descreve “o presidente é chefe de Estado e de governo, com mandato fixo”?', opcoes: ['República', 'Federação', 'Presidencialismo', 'Democracia semidireta'], certa: 2, porque: 'Esse é o sistema de governo: presidencialismo.' },
    { q: 'Quem tem autonomia na Federação brasileira?', opcoes: ['Só a União', 'União e Estados', 'União, Estados e DF', 'União, Estados, DF e Municípios'], certa: 3, porque: 'A Federação brasileira tem três níveis. Os Municípios também são entes federativos autônomos (art. 18).' },
  ]} />

  <PageNav slug="constituicao" />
</Base>
