---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import PageNav from '@/components/layout/PageNav.astro';
import LevelBlock from '@/components/layout/LevelBlock.astro';
import Section from '@/components/ui/Section.astro';
import Callout from '@/components/ui/Callout.astro';
import Icon from '@/components/ui/Icon.astro';
import Fonte from '@/components/ui/Fonte.astro';
import Quiz from '@/components/ui/Quiz.astro';
import { tones } from '@/lib/tones';
import { art, L } from '@/data/links';
import { poderes, freios, ordem } from '@/data/paginas/poderes';
---
<Base title="Os Três Poderes" slug="poderes">
  <PageHeader slug="poderes" />

  <LevelBlock nivel="basico">
    <Section title="Por que existem três Poderes?">
      <Fragment slot="intro">
        <p>Para evitar que uma só pessoa ou instituição tenha poder demais, a Constituição (art. 2º) divide o poder do Estado em três: <strong>Legislativo, Executivo e Judiciário</strong>.</p>
        <p>Eles são <strong>independentes</strong> (um não manda no outro) e <strong>harmônicos</strong> (devem cooperar e se fiscalizar). Clique em cada Poder para ver quem o forma e qual é a sua função principal.</p>
      </Fragment>

      <div role="tablist" aria-label="Poderes" class="flex flex-wrap gap-2" id="tabs-poder">
        {ordem.map((k, i) => (
          <button role="tab" type="button" class={`btn ${i === 0 ? 'is-active' : ''}`} aria-selected={i === 0} data-poder={k}><Icon name={poderes[k].icon} /> {poderes[k].nome}</button>
        ))}
      </div>
      {ordem.map((k, i) => {
        const p = poderes[k];
        const t = tones[p.tone];
        return (
          <div role="tabpanel" data-painel={k} class={`mt-4 rounded-3xl border ${t.border} ${t.bgSoft} p-6 ${i === 0 ? '' : 'hidden'}`}>
            <h3 class="flex items-center gap-2 text-2xl font-bold"><Icon name={p.icon} class={t.text} /> {p.nome}</h3>
            <p class="mt-1 text-lg font-bold">{p.resumo}</p>
            <p class="prose-p mt-3"><strong>Quem faz parte:</strong> {p.quem}</p>
            <div class="card mt-3"><p class={`flex items-center gap-2 font-extrabold ${t.text}`}><Icon name="star" /> Função principal (típica)</p><ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-ink-soft">{p.tipicas.map((x) => <li>{x}</li>)}</ul></div>
          </div>
        );
      })}
    </Section>

    <Section title="Exemplo do dia a dia">
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="card bg-sky-50"><p class="font-extrabold text-sky-600">1. Legislativo</p><p class="mt-1 text-sm text-ink-soft">O Congresso aprova uma lei sobre um tema, por exemplo o trânsito.</p></div>
        <div class="card bg-mint-50"><p class="font-extrabold text-mint-600">2. Executivo</p><p class="mt-1 text-sm text-ink-soft">O governo sanciona a lei e organiza os órgãos que vão aplicá-la.</p></div>
        <div class="card bg-peach-50"><p class="font-extrabold text-peach-600">3. Judiciário</p><p class="mt-1 text-sm text-ink-soft">Se houver conflito sobre a lei, um juiz decide o caso concreto.</p></div>
      </div>
    </Section>

    <Fonte itens={[art(2), art(44, '(Legislativo)'), art(76, '(Executivo)'), art(92, '(Judiciário)'), L.senadoGuia]} />
  </LevelBlock>

  <LevelBlock nivel="avancado">
    <Section title="Funções típicas e atípicas">
      <Fragment slot="intro">
        <p>Cada Poder tem uma função <strong>típica</strong> (a principal) e também exerce, de forma secundária, funções <strong>atípicas</strong> que pertencem a outro Poder. Escolha um Poder abaixo.</p>
      </Fragment>
      <div class="flex flex-wrap gap-2" id="tabs-atip" role="group" aria-label="Poder">
        {ordem.map((k, i) => <button type="button" class={`btn ${i === 0 ? 'is-active' : ''}`} aria-pressed={i === 0} data-a={k}><Icon name={poderes[k].icon} /> {poderes[k].nome}</button>)}
      </div>
      {ordem.map((k, i) => (
        <div data-atip={k} class={`mt-3 grid gap-4 sm:grid-cols-2 ${i === 0 ? '' : 'hidden'}`}>
          <div class="card"><p class="flex items-center gap-2 font-extrabold"><Icon name="star" class="text-lilac-600" /> Típicas</p><ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-ink-soft">{poderes[k].tipicas.map((x) => <li>{x}</li>)}</ul></div>
          <div class="card"><p class="flex items-center gap-2 font-extrabold"><Icon name="shuffle" class="text-lilac-600" /> Atípicas</p><ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-ink-soft">{poderes[k].atipicas.map((x) => <li>{x}</li>)}</ul></div>
        </div>
      ))}
    </Section>

    <Section title="Freios e contrapesos: quem controla quem?">
      <Fragment slot="intro"><p>Escolha qual Poder controla e qual é controlado.</p></Fragment>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <p class="mb-2 text-sm font-bold text-ink-soft">O Poder que controla</p>
          <div class="flex flex-wrap gap-2" id="de">
            {ordem.map((k, i) => <button type="button" class={`btn ${i === 1 ? 'is-active' : ''}`} aria-pressed={i === 1} data-v={k}><Icon name={poderes[k].icon} /> {poderes[k].nome}</button>)}
          </div>
        </div>
        <div>
          <p class="mb-2 text-sm font-bold text-ink-soft">O Poder controlado</p>
          <div class="flex flex-wrap gap-2" id="para">
            {ordem.map((k, i) => <button type="button" class={`btn ${i === 0 ? 'is-active' : ''}`} aria-pressed={i === 0} data-v={k}><Icon name={poderes[k].icon} /> {poderes[k].nome}</button>)}
          </div>
        </div>
      </div>
      <div class="card mt-5 min-h-24 bg-white" aria-live="polite"><p id="freio-out" class="text-lg"></p></div>
      <div class="mt-5">
        <Callout tone="lilac" icon="sync_alt" title="O controle gera negociação">
          <p>Quando o Presidente veta um projeto, o debate continua: o Congresso pode derrubar o veto, em sessão conjunta, por maioria absoluta dos deputados e senadores (art. 66, § 4º). E, como o Senado precisa aprovar os indicados ao STF, o Presidente precisa considerar a força dos partidos ao escolher.</p>
        </Callout>
      </div>
    </Section>

    <Fonte itens={[art(52, '(Senado)'), art(66), art(84), art(101, '(STF)'), art(102), L.camaraProcesso, L.senadoParlamentar]} />
  </LevelBlock>

  <Quiz id="quiz" perguntas={[
    { q: 'Quem sanciona ou veta um projeto de lei aprovado pelo Congresso?', opcoes: ['O Supremo Tribunal Federal', 'O Presidente da República', 'O Presidente do Senado', 'O TCU'], certa: 1, porque: 'A sanção e o veto cabem ao chefe do Executivo (art. 66). O Congresso pode derrubar o veto depois.' },
    { q: 'Um juiz declara que uma lei viola a Constituição. Como se chama esse mecanismo?', opcoes: ['Controle de constitucionalidade', 'Impeachment', 'Veto', 'Sabatina'], certa: 0, porque: 'O Judiciário controla se leis e atos respeitam a Constituição.' },
    { q: 'O Executivo edita uma Medida Provisória. Que tipo de função é essa?', opcoes: ['Típica do Executivo', 'Atípica: legislativa', 'Atípica: julgadora', 'Típica do Legislativo'], certa: 1, porque: 'Legislar é função típica do Legislativo. O Executivo faz isso de forma excepcional, por Medida Provisória (art. 62).' },
  ]} />

  <PageNav slug="poderes" />

  <script define:vars={{ freios, poderes }}>
    const grupo = (sel, attr, painel, key) => {
      const tabs = document.querySelectorAll(sel);
      tabs.forEach((b) => b.addEventListener('click', () => {
        tabs.forEach((x) => { const on = x === b; x.classList.toggle('is-active', on); x.setAttribute('aria-selected', String(on)); x.setAttribute('aria-pressed', String(on)); });
        document.querySelectorAll(`[${painel}]`).forEach((p) => p.classList.toggle('hidden', p.getAttribute(painel) !== b.dataset[key]));
      }));
    };
    grupo('[data-poder]', 'data-poder', 'data-painel', 'poder');
    grupo('[data-a]', 'data-a', 'data-atip', 'a');

    let de = 'exe', para = 'leg';
    const out = document.getElementById('freio-out');
    const render = () => {
      out.textContent = de === para
        ? 'Escolha dois Poderes diferentes. Cada Poder também se controla internamente, mas os freios e contrapesos acontecem entre eles.'
        : `${poderes[de].nome} sobre ${poderes[para].nome}: ${freios[de][para]}`;
    };
    const wire = (id, set) => {
      const btns = document.querySelectorAll(`#${id} button`);
      btns.forEach((b) => b.addEventListener('click', () => {
        set(b.dataset.v);
        btns.forEach((x) => { const on = x === b; x.classList.toggle('is-active', on); x.setAttribute('aria-pressed', String(on)); });
        render();
      }));
    };
    wire('de', (v) => (de = v));
    wire('para', (v) => (para = v));
    render();
  </script>
</Base>
