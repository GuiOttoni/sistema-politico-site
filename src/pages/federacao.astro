---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import PageNav from '@/components/layout/PageNav.astro';
import LevelBlock from '@/components/layout/LevelBlock.astro';
import Section from '@/components/ui/Section.astro';
import Callout from '@/components/ui/Callout.astro';
import InfoCard from '@/components/ui/InfoCard.astro';
import Icon from '@/components/ui/Icon.astro';
import Fonte from '@/components/ui/Fonte.astro';
import Quiz from '@/components/ui/Quiz.astro';
import { art, L } from '@/data/links';
import { demandas, tipos } from '@/data/paginas/federacao';
---
<Base title="Quem faz o quê?" slug="federacao">
  <PageHeader slug="federacao" />

  <LevelBlock nivel="basico">
    <Section title="A regra principal: o interesse predominante">
      <Fragment slot="intro">
        <p>Para saber quem cuida de cada assunto, a Constituição usa uma regra simples:</p>
        <ul class="mb-3 list-disc space-y-1 pl-5 text-ink-soft">
          <li>assunto de interesse <strong>nacional</strong>: <strong>União</strong>;</li>
          <li>assunto de interesse <strong>regional</strong>: <strong>Estados</strong>;</li>
          <li>assunto de interesse <strong>local</strong>: <strong>Municípios</strong>.</li>
        </ul>
        <p>O <strong>Distrito Federal</strong> reúne as tarefas de Estado e de Município e não pode ser dividido em municípios. No Brasil, os Municípios são entes federativos autônomos: têm prefeito, câmara de vereadores, lei orgânica própria e cobram tributos.</p>
      </Fragment>
    </Section>

    <Section title="Simulador: quem faz o quê no dia a dia?">
      <Fragment slot="intro"><p>Escolha uma situação e veja quais entes são responsáveis.</p></Fragment>

      <div class="flex flex-wrap gap-2" id="demandas" role="group" aria-label="Situações">
        {demandas.map((d, i) => (
          <button type="button" class={`btn ${i === 0 ? 'is-active' : ''}`} aria-pressed={i === 0} data-id={d.id}><Icon name={d.icon} /> {d.titulo}</button>
        ))}
      </div>

      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4" id="entes" aria-live="polite">
        {[['uniao', 'flag', 'União'], ['estado', 'map', 'Estado'], ['df', 'location_city', 'Distrito Federal'], ['municipio', 'home_work', 'Município']].map(([k, i, n]) => (
          <div class="card text-center transition-all duration-300" data-ente={k}>
            <Icon name={i} class="text-4xl text-lilac-600" />
            <p class="mt-1 font-display text-lg font-bold">{n}</p>
            <p class="mt-1 text-xs font-extrabold uppercase" data-papel></p>
          </div>
        ))}
      </div>

      <div class="card mt-4 bg-white">
        <div class="flex flex-wrap items-center gap-2">
          <span class="chip bg-butter-100 text-butter-600" id="out-tipo"></span>
          <span class="chip bg-white text-ink-soft ring-1 ring-line" id="out-art"></span>
        </div>
        <h3 class="mt-2 text-xl font-bold" id="out-titulo"></h3>
        <p class="mt-2 text-ink-soft" id="out-texto"></p>
      </div>

      <div class="mt-4 rounded-3xl border border-peach-300 bg-peach-50 p-5">
        <h3 class="flex items-center gap-2 text-xl font-bold text-peach-600"><Icon name="campaign" /> Quem eu devo cobrar?</h3>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <div class="card !p-4"><p class="flex items-center gap-2 text-sm font-extrabold"><Icon name="domain" class="text-mint-600" /> Se o serviço não funciona (Executivo)</p><p class="mt-1 text-sm text-ink-soft" id="out-exec"></p></div>
          <div class="card !p-4"><p class="flex items-center gap-2 text-sm font-extrabold"><Icon name="edit_document" class="text-sky-600" /> Se a lei precisa mudar (Legislativo)</p><p class="mt-1 text-sm text-ink-soft" id="out-leg"></p></div>
        </div>
      </div>
    </Section>

    <Section title="Regra prática para cobrar">
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="card bg-mint-50"><Icon name="domain" class="text-3xl text-mint-600" /><h3 class="mt-2 font-bold">Executivo: prefeito, governador, Presidente</h3><p class="mt-1 text-sm text-ink-soft">Cobre de quem <strong>executa</strong>: o posto de saúde, a creche, o ônibus, a polícia. É o Executivo que administra o serviço e o dinheiro.</p></div>
        <div class="card bg-sky-50"><Icon name="edit_document" class="text-3xl text-sky-600" /><h3 class="mt-2 font-bold">Legislativo: vereador, deputado, senador</h3><p class="mt-1 text-sm text-ink-soft">Cobre de quem <strong>faz as leis, vota o orçamento e fiscaliza</strong> o Executivo. Vereadores, deputados e senadores não administram o serviço: eles fazem a lei e fiscalizam quem administra.</p></div>
        <div class="card bg-peach-50"><Icon name="gavel" class="text-3xl text-peach-600" /><h3 class="mt-2 font-bold">Se um direito foi violado</h3><p class="mt-1 text-sm text-ink-soft">Pode-se recorrer ao Judiciário. O Ministério Público defende os interesses da sociedade (art. 127) e a Defensoria Pública atende quem não pode pagar um advogado (art. 134).</p></div>
      </div>
      <p class="prose-p mt-4 max-w-3xl">Em muitos casos mais de um ente atua. Nesses casos, comece por quem presta o serviço na ponta (em geral, o prefeito) e procure também o parlamentar do nível que faz a lei ou envia o recurso.</p>
    </Section>

    <Fonte itens={[art(18), art(21), art(22), art(23), art(24), art(25), art(30), art(32), art(70, '(fiscalização pelo Legislativo)'), art(127), art(134)]} />
  </LevelBlock>

  <LevelBlock nivel="avancado">
    <Section title="Os seis tipos de competência">
      <Fragment slot="intro">
        <p>A Constituição distribui as competências em dois tipos: as <strong>materiais</strong> (tarefas e serviços que cada ente executa) e as <strong>legislativas</strong> (leis que cada ente pode fazer). Os seis grupos abaixo são os principais.</p>
      </Fragment>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {tipos.map((t) => <InfoCard tone={t.tone} icon={t.icon} tag={t.tag} title={t.titulo}><p>{t.txt}</p></InfoCard>)}
      </div>
    </Section>

    <Section title="Regras da competência concorrente (art. 24, §§ 1º a 4º)">
      <div class="grid gap-4 lg:grid-cols-2">
        <Callout tone="sky" icon="rule" title="Quatro regras">
          <ol class="list-decimal space-y-1 pl-5">
            <li>A União edita apenas <strong>normas gerais</strong>.</li>
            <li>Isso não impede a competência <strong>suplementar</strong> dos Estados.</li>
            <li>Se não existir lei federal, os Estados legislam <strong>de forma plena</strong>.</li>
            <li>Se surgir lei federal sobre normas gerais, ela <strong>suspende a eficácia</strong> da lei estadual no que for contrário.</li>
          </ol>
        </Callout>
        <Callout tone="rose" icon="toggle_off" title="“Suspende” não é o mesmo que “revoga”">
          <p>A lei estadual fica sem efeito apenas no ponto contrário à lei federal. Se a lei federal for revogada mais tarde, a norma estadual volta a valer.</p>
          <p>Conflitos entre os entes são resolvidos pelo STF (art. 102). Questões que envolvem apenas leis federais ficam com o STJ (art. 105).</p>
        </Callout>
      </div>
    </Section>

    <Section title="Cooperação na gestão ambiental">
      <Fragment slot="intro">
        <p>O parágrafo único do art. 23 prevê leis complementares para organizar a cooperação entre os entes. A Lei Complementar nº 140/2011 regula essa cooperação no licenciamento e na fiscalização ambiental.</p>
      </Fragment>
    </Section>

    <Fonte itens={[art(24), art(25), art(102), art(105), L.lc140, L.senadoGuia]} />
  </LevelBlock>

  <Quiz id="quiz" perguntas={[
    { q: 'Uma câmara de vereadores pode criar um novo crime no município?', opcoes: ['Sim, se for de interesse local', 'Não: direito penal é privativo da União', 'Sim, com aval do prefeito', 'Só se o Estado permitir'], certa: 1, porque: 'Art. 22, I: legislar sobre direito penal é privativo da União.' },
    { q: 'Quem organiza o transporte coletivo urbano?', opcoes: ['União', 'Estado', 'Município', 'Ninguém: é privado'], certa: 2, porque: 'Art. 30, V: serviços de interesse local, como o transporte coletivo, são do Município.' },
    { q: 'O Município aparece na lista de competências legislativas concorrentes do art. 24?', opcoes: ['Sim', 'Não, mas complementa as leis pelo art. 30, I e II', 'Sim, só no meio ambiente', 'Não pode legislar sobre esses temas'], certa: 1, porque: 'O art. 24 menciona União, Estados e DF. O Município legisla sobre assuntos locais e complementa as leis federais e estaduais (art. 30).' },
  ]} />

  <PageNav slug="federacao" />

  <script define:vars={{ demandas }}>
    const rotulo = { principal: 'Responsável', apoio: 'Apoia', nenhum: 'Não atua' };
    const estilos = {
      principal: ['border-lilac-300', 'bg-lilac-100', 'scale-105'],
      apoio: ['border-butter-300', 'bg-butter-50'],
      nenhum: ['opacity-40'],
    };
    const all = new Set(Object.values(estilos).flat());
    const btns = document.querySelectorAll('#demandas button');
    const render = (id) => {
      const d = demandas.find((x) => x.id === id);
      document.querySelectorAll('[data-ente]').forEach((el) => {
        const papel = d[el.dataset.ente];
        all.forEach((c) => el.classList.remove(c));
        estilos[papel].forEach((c) => el.classList.add(c));
        el.querySelector('[data-papel]').textContent = rotulo[papel];
      });
      document.getElementById('out-tipo').textContent = d.tipo;
      document.getElementById('out-art').textContent = d.artigo;
      document.getElementById('out-titulo').textContent = d.titulo;
      document.getElementById('out-texto').textContent = d.texto;
      document.getElementById('out-exec').textContent = d.cobrar.executar;
      document.getElementById('out-leg').textContent = d.cobrar.legislar;
    };
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => { const on = x === b; x.classList.toggle('is-active', on); x.setAttribute('aria-pressed', String(on)); });
      render(b.dataset.id);
    }));
    render(demandas[0].id);
  </script>
</Base>
