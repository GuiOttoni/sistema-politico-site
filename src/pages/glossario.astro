---
import Base from '../layouts/Base.astro';
import { href } from '../data/trilha';
import Icon from '../components/Icon.astro';

const termos: [string, string, string][] = [
  ['Accountability', 'Dever de prestar contas e responder pelos atos. Ideia central da República.', 'constituicao'],
  ['Autonomia x soberania', 'Estados, DF e Municípios têm autonomia. Só a República Federativa do Brasil, como um todo, tem soberania internacional.', 'federacao'],
  ['Bicameralismo', 'Parlamento com duas Casas. No Brasil federal: Câmara dos Deputados e Senado. Estados e Municípios têm uma só Casa (unicameralismo).', 'poderes'],
  ['Cláusula de desempenho (barreira)', 'Mínimo de votos ou deputados para o partido ter Fundo Partidário e tempo de rádio/TV (EC 97/2017).', 'partidos'],
  ['Cláusula pétrea', 'Tema que nem emenda constitucional pode abolir: federação, voto direto/secreto/universal/periódico, separação dos Poderes e direitos individuais (Art. 60, § 4º).', 'constituicao'],
  ['Coalizão', 'Aliança de partidos que apoia o governo no Congresso e, em geral, participa dele com ministérios e cargos.', 'coalizao'],
  ['Competência concorrente', 'União, Estados e DF legislam juntos: a União fixa normas gerais (Art. 24).', 'federacao'],
  ['Competência privativa', 'Só a União faz a lei (art. 22), mas uma lei complementar pode autorizar os Estados a legislar sobre pontos específicos.', 'federacao'],
  ['Controle de constitucionalidade', 'Verificação, pelo Judiciário, de que leis e atos respeitam a Constituição.', 'poderes'],
  ['CPI', 'Comissão Parlamentar de Inquérito: investiga fatos determinados. Pode ser de uma Casa ou mista (CPMI).', 'poderes'],
  ['Emenda impositiva', 'Emenda do parlamentar ao Orçamento cuja execução é obrigatória.', 'coalizao'],
  ['Estado laico', 'Estado neutro em matéria religiosa (Art. 19, I).', 'constituicao'],
  ['Federação partidária', 'União de partidos que atuam como um só por pelo menos 4 anos (Lei 14.208/2021).', 'partidos'],
  ['Funções típicas e atípicas', 'Típica = missão principal do Poder. Atípica = tarefa secundária normalmente exercida por outro Poder.', 'poderes'],
  ['Iniciativa popular', 'Projeto de lei de cidadãos: 1% do eleitorado nacional em 5+ Estados, com 0,3% em cada um.', 'leis'],
  ['Inafastabilidade da jurisdição', 'A lei não pode excluir da apreciação do Judiciário lesão ou ameaça a direito (Art. 5º, XXXV).', 'justica'],
  ['Lei complementar', 'Lei sobre matéria exigida pela Constituição, aprovada por maioria absoluta.', 'leis'],
  ['Maiores médias', 'Método de distribuição das sobras eleitorais: votos ÷ (cadeiras já obtidas + 1).', 'eleicoes'],
  ['Majoritário', 'Sistema em que vence quem tem mais votos válidos (presidente, governador, prefeito, senador).', 'eleicoes'],
  ['Medida Provisória (MP)', 'Ato do Presidente com força de lei imediata, em caso de relevância e urgência. Precisa ser votada pelo Congresso.', 'leis'],
  ['Ministério Público', 'Instituição que defende a ordem jurídica e promove a ação penal pública. Não integra os três Poderes.', 'justica'],
  ['Parecer prévio', 'Manifestação técnica do TCU sobre as contas do Presidente; não vincula o Congresso.', 'justica'],
  ['Plebiscito e referendo', 'Consultas populares diretas. No plebiscito, a consulta é anterior à lei; no referendo, é posterior.', 'constituicao'],
  ['Proporcional de lista aberta', 'Sistema de deputados e vereadores: o eleitor vota em candidato ou sigla, e o partido ganha cadeiras proporcionalmente.', 'eleicoes'],
  ['Quinto constitucional', '1/5 das vagas de certos tribunais é de advogados e membros do MP.', 'justica'],
  ['Quociente eleitoral', 'Votos válidos ÷ cadeiras em disputa.', 'eleicoes'],
  ['Quociente partidário', 'Votos do partido ÷ quociente eleitoral (sem fração).', 'eleicoes'],
  ['Sabatina', 'Arguição pública no Senado para aprovar indicados a cargos como ministro do STF.', 'poderes'],
  ['Sanção e veto', 'Aprovação ou rejeição do projeto pelo chefe do Executivo.', 'leis'],
  ['Sobras eleitorais', 'Cadeiras que sobram depois do quociente partidário.', 'eleicoes'],
  ['Tribunal de exceção', 'Tribunal criado para julgar fato já ocorrido. É vedado (Art. 5º, XXXVII).', 'justica'],
  ['Vacatio legis', 'Período entre a publicação e a entrada em vigor de uma lei.', 'leis'],
  ['Voto de legenda', 'Voto na sigla do partido, não em candidato específico.', 'eleicoes'],
];
const ordenados = termos.sort((a, b) => a[0].localeCompare(b[0], 'pt-BR'));
---
<Base title="Glossário" description="Termos do sistema político brasileiro explicados de forma simples.">
  <section class="rounded-[2rem] border border-butter-300 bg-butter-50 p-6 sm:p-10">
    <h1 class="flex items-center gap-3 text-3xl font-bold sm:text-5xl"><Icon name="dictionary" class="text-butter-600" /> Glossário</h1>
    <p class="mt-3 max-w-2xl text-lg text-ink-soft">Termos usados no guia, explicados de forma simples. Cada um leva à etapa em que aparece.</p>
    <label class="mt-5 block max-w-md text-sm font-bold">Buscar termo
      <input id="q" type="search" placeholder="ex.: veto, quociente, pétrea…" class="mt-1 w-full rounded-full border border-line bg-white px-5 py-3 text-base" />
    </label>
  </section>

  <p class="mt-6 text-sm text-ink-soft" id="n" aria-live="polite"></p>
  <dl class="mt-3 grid gap-3 sm:grid-cols-2" id="lista">
    {ordenados.map(([t, d, slug]) => (
      <div class="card !p-4" data-t={`${t} ${d}`.toLowerCase()}>
        <dt class="font-display text-lg font-bold">{t}</dt>
        <dd class="mt-1 text-sm text-ink-soft">{d}</dd>
        <dd class="mt-2"><a href={href(slug)} class="chip bg-lilac-100 text-lilac-600">Ver na trilha <Icon name="arrow_forward" /></a></dd>
      </div>
    ))}
  </dl>

  <script>
    const q = document.getElementById('q') as HTMLInputElement;
    const items = document.querySelectorAll<HTMLElement>('#lista > div');
    const n = document.getElementById('n')!;
    const run = () => {
      const v = q.value.trim().toLowerCase();
      let c = 0;
      items.forEach((el) => { const ok = !v || el.dataset.t!.includes(v); el.classList.toggle('hidden', !ok); if (ok) c++; });
      n.textContent = `${c} de ${items.length} termos`;
    };
    q.addEventListener('input', run);
    run();
  </script>
</Base>
