---
import Base from '@/layouts/Base.astro';
import { href } from '@/data/trilha';
import Icon from '@/components/ui/Icon.astro';
import { termos } from '@/data/paginas/glossario';

const ordenados = termos.sort((a, b) => a[0].localeCompare(b[0], 'pt-BR'));
---
<Base title="Glossário" description="Termos do sistema político brasileiro explicados de forma simples.">
  <section class="rounded-[2rem] border border-butter-300 bg-butter-50 p-6 sm:p-10">
    <h1 class="flex items-center gap-3 text-3xl font-bold sm:text-5xl"><Icon name="dictionary" class="text-butter-600" /> Glossário</h1>
    <p class="mt-3 max-w-2xl text-lg text-ink-soft">Termos usados no guia, explicados de forma simples. Cada um leva à etapa em que aparece.</p>
    <label class="mt-5 block max-w-md text-sm font-bold">Buscar termo
      <input id="q" type="search" placeholder="ex.: veto, quociente, pétrea…" class="mt-1 w-full rounded-full border border-line bg-white px-5 py-3 text-base" />
    </label>
  </section>

  <p class="mt-6 text-sm text-ink-soft" id="n" aria-live="polite"></p>
  <dl class="mt-3 grid gap-3 sm:grid-cols-2" id="lista">
    {ordenados.map(([t, d, slug]) => (
      <div class="card !p-4" data-t={`${t} ${d}`.toLowerCase()}>
        <dt class="font-display text-lg font-bold">{t}</dt>
        <dd class="mt-1 text-sm text-ink-soft">{d}</dd>
        <dd class="mt-2"><a href={href(slug)} class="chip bg-lilac-100 text-lilac-600">Ver na trilha <Icon name="arrow_forward" /></a></dd>
      </div>
    ))}
  </dl>

  <script>
    const q = document.getElementById('q') as HTMLInputElement;
    const items = document.querySelectorAll<HTMLElement>('#lista > div');
    const n = document.getElementById('n')!;
    const run = () => {
      const v = q.value.trim().toLowerCase();
      let c = 0;
      items.forEach((el) => { const ok = !v || el.dataset.t!.includes(v); el.classList.toggle('hidden', !ok); if (ok) c++; });
      n.textContent = `${c} de ${items.length} termos`;
    };
    q.addEventListener('input', run);
    run();
  </script>
</Base>
