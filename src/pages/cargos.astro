---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PageNav from '../components/PageNav.astro';
import LevelBlock from '../components/LevelBlock.astro';
import Section from '../components/Section.astro';
import Callout from '../components/Callout.astro';
import Icon from '../components/Icon.astro';
import Fonte from '../components/Fonte.astro';
import Quiz from '../components/Quiz.astro';
import { tones, type Tone } from '../lib/tones';
import { art, L } from '../data/links';
import { href } from '../data/trilha';

type Esfera = 'Federal' | 'Estadual e Distrital' | 'Municipal';
interface Cargo { esfera: Esfera; nome: string; icon: string; poder: 'Executivo' | 'Legislativo'; tone: Tone; mandato: string; faz: string[]; voto: string; reeleicao: string; qtd?: string; detalhes: string[] }

const cargos: Cargo[] = [
  { esfera: 'Federal', nome: 'Presidente e Vice-Presidente', icon: 'account_balance', poder: 'Executivo', tone: 'mint', mandato: '4 anos',
    faz: ['Chefia o Estado e o governo', 'Sanciona ou veta leis e edita Medidas Provisórias'],
    voto: 'Majoritário, com 2º turno se ninguém tiver mais da metade dos votos válidos', reeleicao: 'Uma reeleição seguida',
    detalhes: ['Nomeia os ministros de Estado', 'Indica ministros do STF e dos tribunais superiores (com aprovação do Senado)', 'Comanda as Forças Armadas e conduz as relações internacionais', 'Envia ao Congresso o plano plurianual, as diretrizes e o orçamento'] },
  { esfera: 'Federal', nome: 'Senador(a)', icon: 'groups', poder: 'Legislativo', tone: 'sky', mandato: '8 anos',
    faz: ['Representa os Estados e o Distrito Federal', 'Aprova autoridades e julga o impeachment'],
    voto: 'Majoritário simples, em turno único', reeleicao: 'Sem limite', qtd: '81 (3 por Estado e 3 pelo DF)',
    detalhes: ['Renovação alternada a cada 4 anos: 1/3 e 2/3 das cadeiras (27 e 54)', 'Sabatina e aprova indicados ao STF, Banco Central, PGR, TCU, embaixadores e agências reguladoras', 'Julga Presidente, Vice e ministros em crimes de responsabilidade', 'Autoriza empréstimos externos'] },
  { esfera: 'Federal', nome: 'Deputado(a) Federal', icon: 'person_raised_hand', poder: 'Legislativo', tone: 'sky', mandato: '4 anos',
    faz: ['Representa o povo, de forma proporcional à população', 'Propõe e vota leis e fiscaliza o governo'],
    voto: 'Proporcional, com lista aberta', reeleicao: 'Sem limite', qtd: '513 (de 8 a 70 por Estado)',
    detalhes: ['Autoriza a abertura de processo contra o Presidente da República', 'Os projetos do Executivo, do STF e de iniciativa popular começam na Câmara', 'Destina emendas ao orçamento da União'] },
  { esfera: 'Estadual e Distrital', nome: 'Governador(a) e Vice', icon: 'location_city', poder: 'Executivo', tone: 'mint', mandato: '4 anos',
    faz: ['Chefia a administração do Estado ou do DF', 'Comanda as polícias Civil e Militar e os Bombeiros'],
    voto: 'Majoritário, com 2º turno se necessário', reeleicao: 'Uma reeleição seguida',
    detalhes: ['Executa políticas regionais de saúde, ensino médio e infraestrutura', 'Explora o gás canalizado, diretamente ou por concessão (art. 25, § 2º)', 'Sanciona ou veta as leis estaduais'] },
  { esfera: 'Estadual e Distrital', nome: 'Deputado(a) Estadual e Distrital', icon: 'record_voice_over', poder: 'Legislativo', tone: 'sky', mandato: '4 anos',
    faz: ['Faz as leis do Estado', 'Fiscaliza o governador e as secretarias'],
    voto: 'Proporcional, com lista aberta', reeleicao: 'Sem limite',
    detalhes: ['Elabora a Constituição Estadual', 'Julga todo ano as contas do governador, com auxílio do Tribunal de Contas do Estado', 'Processa o governador por crime de responsabilidade'] },
  { esfera: 'Municipal', nome: 'Prefeito(a) e Vice', icon: 'home_work', poder: 'Executivo', tone: 'mint', mandato: '4 anos',
    faz: ['Administra o Município', 'Cuida de saúde básica, creches, ensino fundamental, transporte e limpeza urbana'],
    voto: 'Município com até 200 mil eleitores: maioria simples. Acima disso: maioria absoluta, com 2º turno', reeleicao: 'Uma reeleição seguida',
    detalhes: ['Arrecada tributos municipais, como o IPTU e o ISS', 'Sanciona ou veta as leis municipais'] },
  { esfera: 'Municipal', nome: 'Vereador(a)', icon: 'forum', poder: 'Legislativo', tone: 'sky', mandato: '4 anos',
    faz: ['Faz as leis do Município', 'Fiscaliza a Prefeitura'],
    voto: 'Proporcional, com lista aberta', reeleicao: 'Sem limite',
    detalhes: ['Elabora e reforma a Lei Orgânica do Município', 'Vota o orçamento municipal', 'Julga as contas do prefeito. O parecer do Tribunal de Contas só deixa de valer com voto de 2/3 da Câmara (art. 31, § 2º)'] },
];
const esferas: Esfera[] = ['Federal', 'Estadual e Distrital', 'Municipal'];
---
<Base title="Quem eu elejo?" slug="cargos">
  <PageHeader slug="cargos" />

  <LevelBlock nivel="basico">
    <Section title="Como é o voto no Brasil">
      <Fragment slot="intro">
        <p>O voto é <strong>direto</strong>, <strong>secreto</strong>, <strong>universal</strong> e tem <strong>valor igual</strong> para todos (art. 14). Os cargos eleitos têm mandato de 4 anos, exceto o de senador, que dura 8.</p>
      </Fragment>
      <div class="grid gap-4 sm:grid-cols-4">
        {[['touch_app', 'Direto', 'O eleitor escolhe o candidato, sem intermediários.'], ['lock', 'Secreto', 'Ninguém sabe em quem você votou.'], ['public', 'Universal', 'Todo cidadão apto pode votar.'], ['equalizer', 'Valor igual', 'Cada voto vale o mesmo.']].map(([i, t, d]) => (
          <div class="card bg-mint-50"><Icon name={i} class="text-3xl text-mint-600" /><h3 class="mt-2 font-bold">{t}</h3><p class="mt-1 text-sm text-ink-soft">{d}</p></div>
        ))}
      </div>
    </Section>

    <Section title="Os cargos eleitos">
      <Fragment slot="intro"><p>Filtre por esfera (federal, estadual ou municipal) e clique no cartão para ver mais.</p></Fragment>
      <div class="flex flex-wrap gap-2" id="filtro-esfera" role="group" aria-label="Filtrar por esfera">
        <button class="btn is-active" aria-pressed="true" type="button" data-f="todas">Todas</button>
        {esferas.map((e) => <button class="btn" aria-pressed="false" type="button" data-f={e}>{e}</button>)}
      </div>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {cargos.map((c) => {
          const t = tones[c.tone];
          return (
            <article class={`rounded-3xl border ${t.border} bg-white p-5`} data-esfera={c.esfera}>
              <div class="flex items-center gap-3">
                <span class={`grid h-12 w-12 place-items-center rounded-2xl text-2xl ${t.bg} ${t.text}`}><Icon name={c.icon} /></span>
                <div class="flex-1">
                  <h3 class="font-display text-lg font-bold leading-tight">{c.nome}</h3>
                  <p class="text-xs font-bold text-ink-soft">{c.esfera} · {c.poder}</p>
                </div>
              </div>
              <span class={`chip mt-3 ${t.chip}`}><Icon name="schedule" /> Mandato de {c.mandato}</span>
              <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-ink-soft">{c.faz.map((f) => <li>{f}</li>)}</ul>
            </article>
          );
        })}
      </div>
    </Section>

    <Fonte itens={[art(14), art(27, '(deputados estaduais)'), art(28, '(governadores)'), art(29, '(prefeitos e vereadores)'), art(45, '(deputados federais)'), art(46, '(senadores)'), art(77, '(Presidente)')]} />
  </LevelBlock>

  <LevelBlock nivel="avancado">
    <Section title="Detalhes de cada cargo">
      <Fragment slot="intro"><p>Escolha um cargo para ver como é eleito, se pode ser reeleito e outras atribuições.</p></Fragment>
      <div class="flex flex-wrap gap-2" id="seletor-cargo" role="group" aria-label="Cargo">
        {cargos.map((c, i) => <button class={`btn ${i === 0 ? 'is-active' : ''}`} aria-pressed={i === 0} type="button" data-i={i}><Icon name={c.icon} /> {c.nome}</button>)}
      </div>
      {cargos.map((c, i) => (
        <div data-detalhe={i} class={`card mt-4 ${i === 0 ? '' : 'hidden'}`}>
          <h3 class="text-xl font-bold">{c.nome}</h3>
          <dl class="mt-3 grid gap-3 text-sm sm:grid-cols-2">
            <div><dt class="font-extrabold">Como é eleito</dt><dd class="text-ink-soft">{c.voto}</dd></div>
            <div><dt class="font-extrabold">Reeleição</dt><dd class="text-ink-soft">{c.reeleicao}</dd></div>
            {c.qtd && <div><dt class="font-extrabold">Quantos</dt><dd class="text-ink-soft">{c.qtd}</dd></div>}
          </dl>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-ink-soft">{c.detalhes.map((d) => <li>{d}</li>)}</ul>
        </div>
      ))}
    </Section>

    <Section title="Perda e suspensão dos direitos políticos">
      <Fragment slot="intro">
        <p>O art. 15 proíbe a cassação arbitrária de direitos políticos. Eles só são perdidos ou suspensos em casos específicos: cancelamento da naturalização, incapacidade civil absoluta, condenação criminal definitiva (enquanto durarem seus efeitos), recusa de cumprir obrigação a todos imposta e improbidade administrativa.</p>
      </Fragment>
      <Callout tone="peach" icon="calculate" title="Majoritário e proporcional">
        <p>No sistema <strong>majoritário</strong> vence quem tem mais votos. No <strong>proporcional</strong>, as cadeiras são divididas entre os partidos. Veja os detalhes e a calculadora na etapa <a class="underline font-bold" href={href('eleicoes')}>Como o voto vira cadeira</a>.</p>
      </Callout>
    </Section>

    <Fonte itens={[art(15), art(31, '(contas do prefeito)'), art(52, '(competências do Senado)'), art(84, '(competências do Presidente)'), L.senadoGuia, L.camaraProporcional]} />
  </LevelBlock>

  <Quiz id="quiz" perguntas={[
    { q: 'Qual cargo tem o mandato mais longo?', opcoes: ['Presidente', 'Senador', 'Deputado federal', 'Governador'], certa: 1, porque: 'Senadores têm mandato de 8 anos. Os demais cargos, 4 anos.' },
    { q: 'Quantos senadores cada Estado elege?', opcoes: ['1', '2', '3', 'Depende da população'], certa: 2, porque: 'São 3 por Estado e 3 pelo Distrito Federal, totalizando 81 (art. 46).' },
    { q: 'Um prefeito pode ser reeleito quantas vezes de forma seguida?', opcoes: ['Nenhuma', 'Uma', 'Duas', 'Sem limite'], certa: 1, porque: 'Os chefes do Executivo podem ser reeleitos para um único período seguinte.' },
    { q: 'Vereadores são eleitos por qual sistema?', opcoes: ['Majoritário simples', 'Majoritário em 2 turnos', 'Proporcional', 'Sorteio'], certa: 2, porque: 'Deputados (federais, estaduais e distritais) e vereadores são eleitos pelo sistema proporcional.' },
  ]} />

  <PageNav slug="cargos" />

  <script>
    const btns = document.querySelectorAll<HTMLButtonElement>('#filtro-esfera button');
    const cards = document.querySelectorAll<HTMLElement>('[data-esfera]');
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => { const on = x === b; x.classList.toggle('is-active', on); x.setAttribute('aria-pressed', String(on)); });
      cards.forEach((c) => c.classList.toggle('hidden', b.dataset.f !== 'todas' && c.dataset.esfera !== b.dataset.f));
    }));

    const sel = document.querySelectorAll<HTMLButtonElement>('#seletor-cargo button');
    const det = document.querySelectorAll<HTMLElement>('[data-detalhe]');
    sel.forEach((b) => b.addEventListener('click', () => {
      sel.forEach((x) => { const on = x === b; x.classList.toggle('is-active', on); x.setAttribute('aria-pressed', String(on)); });
      det.forEach((d) => d.classList.toggle('hidden', d.dataset.detalhe !== b.dataset.i));
    }));
  </script>
</Base>
